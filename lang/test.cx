import math;

x = 1 + 2 * 8;
print(x);

func add(a, b) {
    return a + b;
}

result = add(10, 20);
print(result);

i = 0;
while (i < 3) {
    print(i);
    i = i + 1;
}

s1 = {3, 4, 5};
d1 = {true: "dict", false : "set"};
s1.add(95);


print(s1);
print(d1);

print(math.sqrt(81));
import random;

list = [1, 3, 4, 9];
choice = random.choice([3, 4, 5]);

print(choice);

print(list);
random.shuffle(list);
print(list);


y = 0;

while y <= math.pi {
    print(y);
    y += 0.3;
}


class Dog() {
    func __struct__(this, name, age) {
        this.name = name;
        this.age = age;
    }

    func action(this) {
        print(f"{this.name} is barking...");
    }
}

dog = Dog("Brooks", 5);
dog.action();