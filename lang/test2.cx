# DNS lookup
info = socket.getaddr("example.com");
print(info["ip"]);

# Raw HTTP request
s = socket.create("tcp");
socket.connect(s, "example.com", 80);
socket.send(s, "GET / HTTP/1.0\r\nHost: example.com\r\n\r\n");
response = socket.recv(s, 8192);
print(response);
socket.close(s);

s = socket.create("tcp");
socket.setopt(s, "reuseaddr", true);
socket.bind(s, "0.0.0.0", 9000);
socket.listen(s);
print("server listening on port 9000");

conn    = socket.accept(s);
c_host  = conn["host"];
c_port  = conn["port"];
c_sock  = conn["socket"];
print(f"client connected from {c_host}:{c_port}");

data = socket.recv(c_sock);
print(f"received: {data}");

socket.send(c_sock, "Hello from CX server!");
socket.close(c_sock);
socket.close(s);
# Simple GET
res = net.get("https://httpbin.org/get");
print(res["status"]);
print(res["body"]);

# GET with headers
headers = dict();
headers["Accept"] = "application/json";
res = net.get("https://httpbin.org/headers", headers);
print(res["status"]);

# POST with JSON body
payload = dict();
payload["name"] = "cx";
payload["version"] = 1;

h = dict();
h["Content-Type"] = "application/json";
res = net.post("https://httpbin.org/post", json.stringify(payload), h);
print(res["status"]);
data = json.parse(res["body"]);
print(data["json"]);

# Custom request
opts = dict();
opts["method"]  = "GET";
opts["url"]     = "https://httpbin.org/status/404";
opts["timeout"] = 10;
res = net.request(opts);
print(res["status"]);

print("End of net");

