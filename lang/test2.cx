func quicksort(arr) 
{
   if (len(arr) < 2) : return arr;

   mid = int(len(arr) / 2);
   pivot = arr[mid];
   left, right = [], [];

   for i in range(len(arr))
   {
      if (i == mid) : continue;
      if arr[i] < pivot : left.append(arr[i]);
      else : right.append(arr[i]);
   }

   return quicksort(left) + [pivot] + quicksort(right);
}

# Generate a large array
arr = [];
i = 0;

while (i < 100000) {
    arr.append((i * 2377 + 1234) % 100000);  # pseudo-random via LCG
    i = i + 1;
}

# before = time.clock();
# quicksort(arr);
# elapsed1 = time.diff(before, time.clock());

before = time.clock();
sorted(arr);
elapsed2 = time.diff(before, time.clock());

print(f"Builtin:   {elapsed2}s");
