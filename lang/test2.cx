# The classic float problem — now exact
print(0.1 + 0.2);
print(decimal.add("0.1", "0.2"));

# High precision division
print(decimal.div("1", "3", 50));
print(decimal.div("355", "113", 30));   # approximation of pi

# Huge numbers — no overflow
print(decimal.factorial("100"));
print(decimal.pow("2", "100"));

# Arbitrary precision sqrt
print(decimal.sqrt("2", 50));

# GCD / LCM
print(decimal.gcd("48", "18"));
print(decimal.lcm("4", "6"));

# Finance example
balance = "1000.00";
i = 0;
while (i < 100) {
    balance = decimal.sub(balance, "0.10");
    i = i + 1;
}
print(balance);  # exactly "990"

