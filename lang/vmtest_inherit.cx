class Animal {
    func __struct__(this, name) {
        this.name = name;
    }
    func speak() {
        return self.name + " makes a sound";
    }
}

class Dog (Animal) {
    func __struct__(this, name) {
        this.name = name;
        this.tricks = [];
    }
    func speak(this) {
        return this.name + " barks";
    }
    func learn(this, trick) {
        this.tricks.append(trick);
    }
}

d = Dog("Rex");
print(d.speak());
d.learn("sit");
d.learn("shake");
print(d.tricks);
