state 0

    0 $accept: . program $end

    LAMBDA    shift, and go to state 1
    NL        shift, and go to state 2
    RETURN    shift, and go to state 3
    CONTINUE  shift, and go to state 4
    BREAK     shift, and go to state 5
    GLOBAL    shift, and go to state 6
    NONLOCAL  shift, and go to state 7
    VARIABLE  shift, and go to state 8
    STRING    shift, and go to state 9
    INTEGER   shift, and go to state 10
    DECIMAL   shift, and go to state 11
    ADD       shift, and go to state 12
    SUB       shift, and go to state 13
    BITNOT    shift, and go to state 14
    TRUE      shift, and go to state 15
    FALSE     shift, and go to state 16
    NONE      shift, and go to state 17
    INVERT    shift, and go to state 18
    '['       shift, and go to state 19
    '('       shift, and go to state 20

    $end      reduce using rule 1 (program)
    CLASS     reduce using rule 22 (@2)
    FUNCTION  reduce using rule 20 (@1)
    TRY       reduce using rule 32 (@7)
    WHILE     reduce using rule 26 (@4)
    FOR       reduce using rule 28 (@5)
    IF        reduce using rule 24 (@3)
    $default  reduce using rule 30 (@6)

    program        go to state 21
    stmt_list      go to state 22
    statement      go to state 23
    simple_stmt    go to state 24
    compound_stmt  go to state 25
    @1             go to state 26
    @2             go to state 27
    @3             go to state 28
    @4             go to state 29
    @5             go to state 30
    @6             go to state 31
    @7             go to state 32
    assignment     go to state 33
    left_side      go to state 34
    value          go to state 35
    ternary        go to state 36
    lambda         go to state 37
    binop          go to state 38
    postfix        go to state 39
    term           go to state 40
    boolean        go to state 41
    list           go to state 42


