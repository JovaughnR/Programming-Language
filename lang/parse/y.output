Grammar

    0 $accept: program $end

    1 program: /* empty */
    2        | stmt_list

    3 block: LBRACE stmt_list RBRACE
    4      | LBRACE RBRACE
    5      | NL block
    6      | ':' simple_stmt

    7 stmt_list: statement
    8          | stmt_list statement

    9 statement: simple_stmt
   10          | compound_stmt
   11          | NL

   12 simple_stmt: assignment ';'
   13            | value ';'
   14            | GLOBAL VARIABLE ';'
   15            | NONLOCAL VARIABLE ';'
   16            | RETURN value ';'
   17            | RETURN ';'
   18            | CONTINUE ';'
   19            | BREAK ';'

   20 @1: /* empty */

   21 compound_stmt: @1 function

   22 @2: /* empty */

   23 compound_stmt: @2 class

   24 @3: /* empty */

   25 compound_stmt: @3 if_stmt

   26 @4: /* empty */

   27 compound_stmt: @4 while_stmt

   28 @5: /* empty */

   29 compound_stmt: @5 for_stmt

   30 @6: /* empty */

   31 compound_stmt: @6 import

   32 @7: /* empty */

   33 compound_stmt: @7 exception

   34 import: IMPORT module NL
   35       | IMPORT module AS VARIABLE NL
   36       | FROM module IMPORT import_items NL
   37       | FROM module IMPORT MUL NL

   38 module: VARIABLE
   39       | module '.' VARIABLE

   40 import_items: import_name
   41             | import_items ',' import_name

   42 import_name: VARIABLE
   43            | import_name '.' VARIABLE

   44 class: CLASS VARIABLE block
   45      | CLASS VARIABLE '(' args ')' block

   46 assignment: left_side '=' values
   47           | left_side equals values

   48 left_side: postfix
   49          | left_side ',' postfix

   50 equals: PLUS_EQ
   51       | MINUS_EQ
   52       | DIV_EQ
   53       | MUL_EQ
   54       | FLDIV_EQ
   55       | EXP_EQ
   56       | MOD_EQ
   57       | R_SHIFT_EQ
   58       | L_SHIFT_EQ
   59       | XOR_EQ
   60       | AND_EQ
   61       | OR_EQ

   62 value: ternary

   63 ternary: lambda
   64        | lambda QMARK lambda ':' ternary

   65 lambda: binop
   66       | LAMBDA param_list ':' lambda

   67 binop: binop LOGIC_OR binop
   68      | binop LOGIC_AND binop
   69      | binop BITOR binop
   70      | binop BITXOR binop
   71      | binop BITAND binop
   72      | binop EQ binop
   73      | binop NE binop
   74      | binop LT binop
   75      | binop GT binop
   76      | binop LE binop
   77      | binop GE binop
   78      | binop L_SHIFT binop
   79      | binop R_SHIFT binop
   80      | binop ADD binop
   81      | binop SUB binop
   82      | binop MUL binop
   83      | binop DIV binop
   84      | binop MOD binop
   85      | binop FLDIV binop
   86      | binop EXP binop
   87      | INVERT binop
   88      | BITNOT binop
   89      | SUB binop
   90      | ADD binop
   91      | '(' value ')'
   92      | postfix

   93 postfix: term
   94        | postfix '(' args ')'
   95        | postfix '(' args ',' kwargs ')'
   96        | postfix '.' VARIABLE
   97        | postfix '[' value ']'
   98        | postfix sliced_items

   99 term: INTEGER
  100     | DECIMAL
  101     | STRING
  102     | boolean
  103     | list
  104     | VARIABLE
  105     | NONE

  106 args: /* empty */
  107     | value
  108     | args ',' value

  109 boolean: TRUE
  110        | FALSE

  111 list: '[' ']'
  112     | '[' values ']'

  113 sliced_items: '[' slice_start ':' slice_end ':' slice_end ']'
  114             | '[' slice_start ':' slice_end ']'

  115 slice_start: /* empty */
  116            | value

  117 slice_end: /* empty */
  118          | value

  119 values: value
  120       | values ',' value

  121 kwargs: kwarg
  122       | kwargs ',' kwarg

  123 kwarg: VARIABLE '=' value

  124 @8: /* empty */

  125 function: FUNCTION VARIABLE '(' param_list ')' @8 block

  126 param_list: /* empty */
  127           | param_item
  128           | param_list ',' param_item

  129 param_item: VARIABLE
  130           | VARIABLE '=' value

  131 @9: /* empty */

  132 while_stmt: WHILE value @9 block

  133 if_stmt: IF value block elif_chain else_block

  134 elif_chain: /* empty */
  135           | ELIF value block elif_chain

  136 else_block: /* empty */
  137           | ELSE block

  138 @10: /* empty */

  139 for_stmt: FOR VARIABLE IN postfix @10 block

  140 exception: try_block catch_block
  141          | try_block final_block
  142          | try_block catch_block final_block

  143 try_block: TRY block

  144 catch_block: CATCH VARIABLE block
  145            | CATCH block
  146            | CATCH VARIABLE AS VARIABLE block

  147 final_block: FINALLY block


