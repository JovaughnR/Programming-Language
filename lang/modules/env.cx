# ============================================================
#  env.cx — Env Module
#  Environment variable management and .env file loading.
#
#  Usage:
#     import env;
#     env.load();
#     print(env.get("HOME"));
# ============================================================

# load(path=".env") -> dict
# Loads a .env file and sets all variables into the environment.
# Returns a dict of all key/value pairs that were loaded.
# Lines starting with # are treated as comments.
# Supports quoted values and inline comments.
# Example: env.load()             # loads .env in current directory
# Example: env.load(".env.prod")  # loads a specific env file
func load(path = ".env") : return __env_load__(path);

# get(key, default=none) -> str | none
# Gets an environment variable by name.
# Returns default value if the variable is not set.
# Example: env.get("HOME")            -> "/Users/jovaughn"
# Example: env.get("PORT", "3000")    -> "3000" if PORT not set
func get(key, default = none) : return __env_get__(key, default);

# set(key, value) -> none
# Sets an environment variable for the current process.
# Does not persist after the process exits.
# Example: env.set("DEBUG", "true")
# Example: env.set("PORT", "8080")
func set(key, value) : return __env_set__(key, value);

# has(key) -> bool
# Returns true if the environment variable is set.
# Example: env.has("HOME")         -> true
# Example: env.has("MISSING_VAR")  -> false
func has(key) : return __env_has__(key);

# all() -> dict
# Returns a dict of all current environment variables.
# Example: vars = env.all()
# Example: print(vars["PATH"])
func all() : return __env_all__();

# unset(key) -> none
# Removes an environment variable from the current process.
# Example: env.unset("DEBUG")
func unset(key) : return __env_unset__(key);