func sum_primes(limit) {
    total = 0;
    i = 2;
    while (i < limit) {
        is_prime = true;
        j = 2;
        while (j * j <= i) {
            if (i % j == 0) {
                is_prime = false;
            }
            j = j + 1;
        }
        if (is_prime) {
            total = total + i;
        }
        i = i + 1;
    }
    return total;
}

print(sum_primes(10000));
